# Server Port
PORT=3001

# AI SDK Credentials (@razinmohammedpt/hackai-sdk or API fallback)
HACKAI_API_KEY=your_hackai_or_ai_api_key_here

# AI Response Mode: SHORT_HUMAN (default concise 1-3 sentences) or HIGH_DETAIL
AI_RESPONSE_MODE=SHORT_HUMAN

# Anti-Ban Safety Parameters
MIN_TYPING_DELAY_MS=2500
MAX_TYPING_DELAY_MS=5500
MAX_DAILY_LIMIT=5
